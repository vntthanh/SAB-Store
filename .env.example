# SAB Store Environment Configuration Example
# Copy this file to .env and fill in real values.
# prod.compose.yml uses `${VAR:?message}` for every secret below: the
# container refuses to boot if the variable is missing, instead of
# silently falling back to an insecure default.

# ── Timezone ─────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ── Public origin (single source of truth) ──────────────────────────────
# The one domain the site is served on. Backend derives CORS_ORIGIN and
# BASE_URL from this alone - do not set them separately.
PUBLIC_URL=https://store.sabies.vn

# ── Redis (stock-movement queue) ─────────────────────────────────────────
# 16+ characters, only A-Z a-z 0-9 . _ ~ - (it is embedded in REDIS_URL).
# Runtime-only in Coolify: turn off "Available during build".
REDIS_PASSWORD=change-me-to-a-long-random-value

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Read by the postgres service, the release job and the backend, which build
# DATABASE_URL from them. The dev stack needs
# none of these: leave them commented out and compose.yml's dev defaults apply,
# which backend/.env.example's DATABASE_URL also matches. User and database: only a-z 0-9 _. Password: lowercase hex of at
# least 32 characters (`openssl rand -hex 24`), because it sits unescaped in
# DATABASE_URL; anything else and the postgres container refuses to start.
# Runtime-only in Coolify: turn off "Available during build".
# SAB_PG_USER=sabstore
# SAB_PG_PASSWORD=change-me-openssl-rand-hex-24
# SAB_PG_DB=sabstore

# ── MongoDB (pre-cutover data; only prod.compose.yml still runs on it) ────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=minipreorder
MONGODB_PORT=27017
# Connection string for a backend pinned to DATA_BACKEND=mongo (prod.compose.yml).
# It uses the root account above, which retires with MongoDB rather than being
# split into a scoped user.
MONGODB_URI=mongodb://admin:change-me@mongodb:27017/minipreorder?authSource=admin

# ── Object storage (SeaweedFS, S3 API) ───────────────────────────────────
# Variable names stay MINIO_* because the backend uses the `minio` SDK.
# ROOT_USER/PASSWORD become the S3 identity: at least 16 characters, not
# `minioadmin`, no `"` or `\` - otherwise the storage container refuses to start.
MINIO_ROOT_USER=change-me-access-key-16+
MINIO_ROOT_PASSWORD=change-me-secret-key-16+
MINIO_ENDPOINT=sabstore-seaweedfs
MINIO_PORT=9000
MINIO_BUCKET_NAME=sabstore
MINIO_USE_SSL=false
# The backend authenticates with the same pair via MINIO_ACCESS_KEY/MINIO_SECRET_KEY
# in the compose files. The identity is limited to the `sabstore` bucket.

# ── Backend ──────────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
# Read only to create the first admin when the database has none (all three
# together; a database with no users refuses to boot without them). Remove
# them once that admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── Dev-only (compose.yml host port bindings, loopback-only) ────────────
NGINX_PORT=80

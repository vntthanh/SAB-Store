# SAB Store Environment Configuration Example
# Copy this file to .env and fill in real values.
# prod.compose.yml uses `${VAR:?message}` for every secret below: the
# container refuses to boot if the variable is missing, instead of
# silently falling back to an insecure default.

# ── Timezone ─────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ── Public origin (single source of truth) ──────────────────────────────
# The one domain the site is served on. Backend derives CORS_ORIGIN and
# BASE_URL from this alone - do not set them separately (AD-2/AD-3).
PUBLIC_URL=https://store.sabies.vn

# ── Redis (stock-movement queue) ─────────────────────────────────────────
# 16+ characters, only A-Z a-z 0-9 . _ ~ - (it is embedded in REDIS_URL).
# Runtime-only in Coolify: turn off "Available during build".
REDIS_PASSWORD=change-me-to-a-long-random-value

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=minipreorder
MONGODB_PORT=27017
# Full connection string used by the backend. Currently the same root
# account as above - TODO: create a Mongo user scoped to `minipreorder`
# (readWrite only) via db.createUser() and point this at that user instead
# of root. Intentionally kept separate from the vars above so that split
# can happen without touching this file's shape (AD-2).
MONGODB_URI=mongodb://admin:change-me@mongodb:27017/minipreorder?authSource=admin

# ── Object storage (SeaweedFS, S3 API) ───────────────────────────────────
# Variable names stay MINIO_* because the backend uses the `minio` SDK.
# ROOT_USER/PASSWORD become the S3 identity: at least 16 characters, not
# `minioadmin`, no `"` or `\` - otherwise the storage container refuses to start.
MINIO_ROOT_USER=change-me-access-key-16+
MINIO_ROOT_PASSWORD=change-me-secret-key-16+
MINIO_ENDPOINT=sabstore-seaweedfs
MINIO_PORT=9000
MINIO_BUCKET_NAME=sabstore
MINIO_USE_SSL=false
# The backend authenticates with the same pair via MINIO_ACCESS_KEY/MINIO_SECRET_KEY
# in the compose files. The identity is limited to the `sabstore` bucket.

# ── Backend ──────────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
APPSCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# ── Dev-only (compose.yml host port bindings, loopback-only) ────────────
NGINX_PORT=80

# Backend-only env, for running `node server.js` / `yarn dev` outside Docker.
# Copy to backend/.env and fill in real values.

# Environment
NODE_ENV=development
PORT=5000

# Public origin (single source of truth) - keep BASE_URL and CORS_ORIGIN
# equal to PUBLIC_URL (AD-2/AD-3). Compose derives them automatically via
# `${PUBLIC_URL}` interpolation; this file is loaded by plain `dotenv`
# (no variable expansion), so update all three by hand when it changes.
PUBLIC_URL=http://localhost:5000
BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5000

# Database
MONGODB_URI=mongodb://admin:password123@localhost:27017/minipreorder?authSource=admin

# JWT Secret (used by better-auth)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=sab@fit.hcmus.edu.vn

# App Script Google Forms
APPSCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# Bank account (VietQR) and payment prefix are store configuration, set by the
# admin in Settings - not environment variables.

# Object storage (SeaweedFS, S3 API). Names stay MINIO_* because the backend
# uses the `minio` SDK. Use the same pair the storage container was started
# with (MINIO_ROOT_USER/MINIO_ROOT_PASSWORD in the repo-root .env.example):
# at least 16 characters and not `minioadmin`.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me-access-key-16+
MINIO_SECRET_KEY=change-me-secret-key-16+
MINIO_BUCKET_NAME=sabstore
MINIO_USE_SSL=false

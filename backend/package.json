{
	"name": "minipreorder-backend",
	"version": "1.0.0",
	"packageManager": "pnpm@10.33.0",
	"description": "Backend API for Mini Preorder System",
	"main": "server.js",
	"scripts": {
		"pretest": "pnpm --filter @sab/shared build && prisma generate",
		"predev": "pnpm --filter @sab/shared build && prisma generate",
		"start": "node start.js",
		"start:direct": "node server.js",
		"dev": "nodemon server.js",
		"test": "vitest run",
		"init-db": "node init-database.js",
		"debug": "node check-env.js && node start.js"
	},
	"dependencies": {
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@prisma/client-runtime-utils": "7.10.0",
		"@sab/shared": "workspace:*",
		"axios": "^1.20.0",
		"better-auth": "1.7.7",
		"bullmq": "^6.3.12",
		"compression": "^1.8.2",
		"cors": "^2.8.6",
		"dotenv": "^18.0.7",
		"exceljs": "^4.4.0",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"ioredis": "^6.0.0",
		"minio": "^8.0.7",
		"mongodb": "^6.21.0",
		"mongoose": "^8.24.5",
		"mongoose-paginate-v2": "^1.9.5",
		"multer": "1.4.5-lts.2",
		"pg": "8.23.1",
		"sharp": "^0.35.5",
		"slugify": "^1.6.9"
	},
	"devDependencies": {
		"embedded-postgres": "17.10.0-beta.17",
		"mongodb-memory-server": "^11.3.0",
		"nodemon": "^3.1.14",
		"prisma": "7.10.0",
		"redis-memory-server": "^0.17.1",
		"supertest": "^7.3.1",
		"vitest": "^5.0.3"

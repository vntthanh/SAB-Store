// Store tables. Ids keep the 24-hex ObjectId strings already held by browsers
// (carts), idempotency keys and queue job ids; rows created here get a 24-hex id
// from the database. Hex ids are not time ordered: never ORDER BY id for recency.
// The id default is written the way Postgres prints it back: any other spelling
// makes every `migrate dev` see drift and rewrite the default.
// The CHECK constraints, the partial index pending_by_age and anything else
// Prisma cannot express are appended by hand to the init migration.

enum SalesChannel {
  all
  online
  offline

  @@map("sales_channel")
}

enum OrderStatus {
  confirmed
  paid
  delivered
  cancelled

  @@map("order_status")
}

enum MovementType {
  opening
  order
  order_cancel
  order_edit
  adjust
  set_target

  @@map("movement_type")
}

enum MovementStatus {
  pending
  applied

  @@map("movement_status")
}

model Product {
  id               String       @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  name             String
  description      String?
  price            Int
  imageUrl         String       @default("/fallback-product.png") @map("image_url")
  category         String
  available        Boolean      @default(true)
  isActive         Boolean      @default(true) @map("is_active")
  salesChannel     SalesChannel @default(all) @map("sales_channel")
  stockQuantity    Int          @default(0) @map("stock_quantity")
  minOrderQuantity Int          @default(1) @map("min_order_quantity")
  maxOrderQuantity Int?         @map("max_order_quantity")
  sku              String?      @unique
  tags             String[]     @default([])
  weight           Float?
  dimensionLength  Float?       @map("dimension_length")
  dimensionWidth   Float?       @map("dimension_width")
  dimensionHeight  Float?       @map("dimension_height")
  featured         Boolean      @default(false)
  salePrice        Int?         @map("sale_price")
  saleStartDate    DateTime?    @map("sale_start_date") @db.Timestamptz(3)
  saleEndDate      DateTime?    @map("sale_end_date") @db.Timestamptz(3)
  publicCode       String       @unique @map("public_code")
  slug             String
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category])
  @@index([available])
  @@index([salesChannel])
  @@index([featured])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model Combo {
  id           String                     @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  name         String
  description  String?
  price        Int
  isActive     Boolean                    @default(true) @map("is_active")
  salesChannel SalesChannel               @default(all) @map("sales_channel")
  priority     Int                        @default(0)
  publicCode   String                     @unique @map("public_code")
  slug         String
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  requirements ComboCategoryRequirement[]

  @@index([isActive, priority(sort: Desc), createdAt(sort: Desc)])
  @@map("combos")
}

model ComboCategoryRequirement {
  id       String @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  comboId  String @map("combo_id")
  combo    Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  position Int
  category String
  quantity Int

  @@unique([comboId, position])
  @@map("combo_category_requirements")
}

model Order {
  id              String              @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  orderCode       String              @unique @map("order_code") @db.VarChar(10)
  orderNumber     String?             @unique @map("order_number")
  phoneNumber     String?             @map("phone_number")
  studentId       String?             @map("student_id")
  fullName        String?             @map("full_name")
  email           String?
  additionalNote  String?             @map("additional_note")
  totalAmount     Int                 @map("total_amount")
  status          OrderStatus         @default(confirmed)
  stockDeducted   Boolean             @default(false) @map("stock_deducted")
  transactionCode String?             @map("transaction_code")
  cancelReason    String?             @map("cancel_reason")
  itemsRevision   Int                 @default(0) @map("items_revision")
  lastUpdatedBy   String              @default("system") @map("last_updated_by")
  statusUpdatedAt DateTime            @default(now()) @map("status_updated_at") @db.Timestamptz(3)
  isDirectSale    Boolean             @default(false) @map("is_direct_sale")
  createdBy       String?             @map("created_by")
  comboInfo       Json?               @map("combo_info")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  items           OrderItem[]
  statusHistory   OrderStatusEntry[]
  internalNotes   OrderInternalNote[]
  itemsEdits      OrderItemsEdit[]

  @@index([studentId])
  @@index([email])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([isDirectSale])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  orderId     String  @map("order_id")
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position    Int
  productId   String  @map("product_id")
  productName String  @map("product_name")
  price       Int
  quantity    Int
  fromCombo   Boolean @default(false) @map("from_combo")
  comboId     String? @map("combo_id")
  comboName   String? @map("combo_name")

  @@unique([orderId, position])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusEntry {
  id              String      @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  orderId         String      @map("order_id")
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position        Int
  status          OrderStatus
  updatedBy       String      @map("updated_by")
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)
  transactionCode String?     @map("transaction_code")
  cancelReason    String?     @map("cancel_reason")
  note            String?

  @@unique([orderId, position])
  @@map("order_status_history")
}

model OrderInternalNote {
  id       String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  orderId  String   @map("order_id")
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  note     String
  by       String
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, position])
  @@map("order_internal_notes")
}

model OrderItemsEdit {
  id                String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  orderId           String   @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position          Int
  previousItems     Json     @map("previous_items")
  previousComboInfo Json?    @map("previous_combo_info")
  editedBy          String   @map("edited_by")
  editedAt          DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)
  reason            String

  @@unique([orderId, position])
  @@map("order_items_edits")
}

model StockMovement {
  id             String         @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  productId      String         @map("product_id")
  type           MovementType
  delta          Int?
  target         Int?
  orderId        String?        @map("order_id")
  reason         String         @default("")
  createdBy      String         @default("") @map("created_by")
  idempotencyKey String         @unique @map("idempotency_key")
  status         MovementStatus @default(pending)
  appliedAt      DateTime?      @map("applied_at") @db.Timestamptz(3)
  stockAfter     Int?           @map("stock_after")
  claimedAt      DateTime?      @map("claimed_at") @db.Timestamptz(3)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  seq            Int            @unique @default(autoincrement())

  @@index([productId, status, seq])
  @@map("stock_movements")
}

// One row. NULL in a notice or contact column means "never set, use the code
// default"; an empty string is a deliberate choice to hide the box.
model Settings {
  id                 String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  key                String   @unique @default("payment_config")
  bankNameId         String   @map("bank_name_id")
  bankAccountId      String   @map("bank_account_id")
  prefixMessage      String   @default("SAB") @map("prefix_message")
  storeTitle         String?  @map("store_title")
  checkoutNotice     String?  @map("checkout_notice")
  eventNotice        String?  @map("event_notice")
  paymentNotice      String?  @map("payment_notice")
  contactEmail       String?  @map("contact_email")
  contactFacebookUrl String?  @map("contact_facebook_url")
  updatedBy          String   @default("system") @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

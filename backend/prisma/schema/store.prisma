// Store tables. Every id is a UUIDv7, generated by Prisma Client (the default is
// applied client-side, so a raw SQL insert must supply its own id; the column has
// no database default). Rows migrated from MongoDB carry their ObjectId mapped
// through objectIdToUuidV7 in @sab/shared, which keeps their time order.
// UUIDv7 sorts by creation time, so `id` may be used as a tiebreaker, but the
// stock ledger orders by `seq`, not by id.
// orders.created_by is the seller's user id, so it is a uuid (no foreign key: a
// deleted user must not touch an order). The actor columns on movements, status
// history, settings and orders.last_updated_by hold "system", an admin email or a
// username, not an id, so they stay text.
// The CHECK constraints, the partial index pending_by_age and anything else
// Prisma cannot express are appended by hand to the migration that creates the
// table (the storefront rule CHECKs and partial unique live in the storefronts one).

enum SalesChannel {
  all
  online
  offline

  @@map("sales_channel")
}

enum OrderStatus {
  confirmed
  paid
  delivered
  cancelled

  @@map("order_status")
}

enum MovementType {
  opening
  order
  order_cancel
  order_edit
  adjust
  set_target

  @@map("movement_type")
}

enum MovementStatus {
  pending
  applied

  @@map("movement_status")
}

enum StorefrontVisibility {
  PUBLIC
  PRIVATE

  @@map("storefront_visibility")
}

enum StorefrontRuleType {
  EMAIL
  DOMAIN
  LIST

  @@map("storefront_rule_type")
}

// A separately browsable shop front. PRIVATE ones are visible only to viewers a
// rule admits. The default row is inserted by its migration with a fixed id
// (backend/data/default-storefront.js); products must belong to exactly one.
model Storefront {
  id          String                 @id @default(uuid(7)) @db.Uuid
  slug        String                 @unique @db.VarChar(60)
  name        String                 @db.VarChar(80)
  description String?                @db.VarChar(500)
  visibility  StorefrontVisibility   @default(PUBLIC)
  sortOrder   Int                    @default(0) @map("sort_order")
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  products    Product[]
  combos      ComboStorefront[]
  orders      Order[]
  rules       StorefrontAccessRule[]

  @@index([isActive, sortOrder, id])
  @@map("storefronts")
}

// EMAIL: value is a lowercase address; DOMAIN: a lowercase domain; LIST: value is
// NULL and emailListId points at the list. The CHECKs and the partial unique for
// LIST rules are in the migration.
model StorefrontAccessRule {
  id           String             @id @default(uuid(7)) @db.Uuid
  storefrontId String             @map("storefront_id") @db.Uuid
  storefront   Storefront         @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  type         StorefrontRuleType
  value        String?            @db.VarChar(254)
  emailListId  String?            @map("email_list_id") @db.Uuid
  emailList    EmailList?         @relation(fields: [emailListId], references: [id], onDelete: Cascade)
  createdBy    String?            @map("created_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([storefrontId, type, value])
  @@index([storefrontId])
  @@index([emailListId])
  @@map("storefront_access_rules")
}

model EmailList {
  id          String                 @id @default(uuid(7)) @db.Uuid
  name        String                 @unique @db.VarChar(80)
  description String?                @db.VarChar(500)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  entries     EmailListEntry[]
  rules       StorefrontAccessRule[]

  @@map("email_lists")
}

model EmailListEntry {
  id          String    @id @default(uuid(7)) @db.Uuid
  emailListId String    @map("email_list_id") @db.Uuid
  emailList   EmailList @relation(fields: [emailListId], references: [id], onDelete: Cascade)
  email       String    @db.VarChar(254)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([emailListId, email])
  @@index([email])
  @@map("email_list_entries")
}

// A combo can be offered in several storefronts; it matches products by category,
// so a link table is all it needs. A combo with no link is unreachable, which the
// repository refuses (the database cannot express "at least one" without a trigger).
model ComboStorefront {
  id           String     @id @default(uuid(7)) @db.Uuid
  comboId      String     @map("combo_id") @db.Uuid
  combo        Combo      @relation(fields: [comboId], references: [id], onDelete: Cascade)
  storefrontId String     @map("storefront_id") @db.Uuid
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Restrict)

  @@unique([comboId, storefrontId])
  @@index([storefrontId])
  @@map("combo_storefronts")
}

model Product {
  id               String       @id @default(uuid(7)) @db.Uuid
  name             String
  description      String?
  price            Int
  imageUrl         String       @default("/fallback-product.png") @map("image_url")
  category         String
  available        Boolean      @default(true)
  isActive         Boolean      @default(true) @map("is_active")
  salesChannel     SalesChannel @default(all) @map("sales_channel")
  stockQuantity    Int          @default(0) @map("stock_quantity")
  minOrderQuantity Int          @default(1) @map("min_order_quantity")
  maxOrderQuantity Int?         @map("max_order_quantity")
  sku              String?      @unique
  tags             String[]     @default([])
  weight           Float?
  dimensionLength  Float?       @map("dimension_length")
  dimensionWidth   Float?       @map("dimension_width")
  dimensionHeight  Float?       @map("dimension_height")
  featured         Boolean      @default(false)
  salePrice        Int?         @map("sale_price")
  saleStartDate    DateTime?    @map("sale_start_date") @db.Timestamptz(3)
  saleEndDate      DateTime?    @map("sale_end_date") @db.Timestamptz(3)
  publicCode       String       @unique @map("public_code")
  slug             String
  storefrontId     String       @map("storefront_id") @db.Uuid
  storefront       Storefront   @relation(fields: [storefrontId], references: [id], onDelete: Restrict)
  // Gallery order; the first image is the cover, which image_url mirrors (a CHECK
  // in the product_variants migration keeps the two equal).
  images           String[]     @default([])
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  options          ProductOption[]
  variants         ProductVariant[]

  @@index([category])
  @@index([storefrontId])
  @@index([available])
  @@index([salesChannel])
  @@index([featured])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

// An option type of a product ("Màu", "Size") and its ordered value labels.
model ProductOption {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  name      String   @db.VarChar(30)
  values    String[]

  @@unique([productId, position])
  @@unique([productId, name])
  @@map("product_options")
}

// One sellable combination: one value label per option, in option position order.
// A product without options has exactly one variant whose option_values is empty
// (the default variant), so pricing, orders and the stock ledger always work per
// variant. stock_quantity is written only by the stock ledger worker, like the
// product's, which is the sum of its variants. An archived variant was removed
// from the options but has history, so it keeps its labels and its stock.
model ProductVariant {
  id            String    @id @default(uuid(7)) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position      Int
  optionValues  String[]  @map("option_values")
  price         Int?
  sku           String?   @unique
  imageUrl      String?   @map("image_url")
  isActive      Boolean   @default(true) @map("is_active")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  stockQuantity Int       @default(0) @map("stock_quantity")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([productId, optionValues])
  @@index([productId, position])
  @@map("product_variants")
}

model Combo {
  id           String                     @id @default(uuid(7)) @db.Uuid
  name         String
  description  String?
  price        Int
  isActive     Boolean                    @default(true) @map("is_active")
  salesChannel SalesChannel               @default(all) @map("sales_channel")
  priority     Int                        @default(0)
  publicCode   String                     @unique @map("public_code")
  slug         String
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  requirements ComboCategoryRequirement[]
  storefronts  ComboStorefront[]

  @@index([isActive, priority(sort: Desc), createdAt(sort: Desc)])
  @@map("combos")
}

model ComboCategoryRequirement {
  id       String @id @default(uuid(7)) @db.Uuid
  comboId  String @map("combo_id") @db.Uuid
  combo    Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  position Int
  category String
  quantity Int

  @@unique([comboId, position])
  @@map("combo_category_requirements")
}

model Order {
  id              String              @id @default(uuid(7)) @db.Uuid
  orderCode       String              @unique @map("order_code") @db.VarChar(10)
  orderNumber     String?             @unique @map("order_number")
  phoneNumber     String?             @map("phone_number")
  studentId       String?             @map("student_id")
  fullName        String?             @map("full_name")
  email           String?
  additionalNote  String?             @map("additional_note")
  totalAmount     Int                 @map("total_amount")
  status          OrderStatus         @default(confirmed)
  stockDeducted   Boolean             @default(false) @map("stock_deducted")
  transactionCode String?             @map("transaction_code")
  cancelReason    String?             @map("cancel_reason")
  itemsRevision   Int                 @default(0) @map("items_revision")
  lastUpdatedBy   String              @default("system") @map("last_updated_by")
  statusUpdatedAt DateTime            @default(now()) @map("status_updated_at") @db.Timestamptz(3)
  isDirectSale    Boolean             @default(false) @map("is_direct_sale")
  createdBy       String?             @map("created_by") @db.Uuid
  comboInfo       Json?               @map("combo_info")
  storefrontId    String?             @map("storefront_id") @db.Uuid
  storefront      Storefront?         @relation(fields: [storefrontId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  items           OrderItem[]
  statusHistory   OrderStatusEntry[]
  internalNotes   OrderInternalNote[]
  itemsEdits      OrderItemsEdit[]

  @@index([studentId])
  @@index([email])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([isDirectSale])
  @@index([storefrontId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position    Int
  productId   String  @map("product_id") @db.Uuid
  productName String  @map("product_name")
  price       Int
  quantity    Int
  fromCombo   Boolean @default(false) @map("from_combo")
  comboId     String? @map("combo_id") @db.Uuid
  comboName   String? @map("combo_name")
  // No foreign key, like product_id. NULL when the line names no variant (a line of
  // a product deleted before variants existed). The label ("Đỏ / M") is a snapshot;
  // NULL for a default variant.
  variantId    String? @map("variant_id") @db.Uuid
  variantLabel String? @map("variant_label")

  @@unique([orderId, position])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusEntry {
  id              String      @id @default(uuid(7)) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position        Int
  status          OrderStatus
  updatedBy       String      @map("updated_by")
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)
  transactionCode String?     @map("transaction_code")
  cancelReason    String?     @map("cancel_reason")
  note            String?

  @@unique([orderId, position])
  @@map("order_status_history")
}

model OrderInternalNote {
  id       String   @id @default(uuid(7)) @db.Uuid
  orderId  String   @map("order_id") @db.Uuid
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  note     String
  by       String
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, position])
  @@map("order_internal_notes")
}

model OrderItemsEdit {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position          Int
  previousItems     Json     @map("previous_items")
  previousComboInfo Json?    @map("previous_combo_info")
  editedBy          String   @map("edited_by")
  editedAt          DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)
  reason            String

  @@unique([orderId, position])
  @@map("order_items_edits")
}

model StockMovement {
  id             String         @id @default(uuid(7)) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  // No foreign key, like product_id: a movement outlives a deleted variant.
  variantId      String         @map("variant_id") @db.Uuid
  type           MovementType
  delta          Int?
  target         Int?
  orderId        String?        @map("order_id") @db.Uuid
  reason         String         @default("")
  createdBy      String         @default("") @map("created_by")
  idempotencyKey String         @unique @map("idempotency_key")
  status         MovementStatus @default(pending)
  appliedAt      DateTime?      @map("applied_at") @db.Timestamptz(3)
  stockAfter     Int?           @map("stock_after")
  claimedAt      DateTime?      @map("claimed_at") @db.Timestamptz(3)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  seq            Int            @unique @default(autoincrement())

  @@index([productId, status, seq])
  @@index([variantId, status])
  @@map("stock_movements")
}

// One row. NULL in a notice or contact column means "never set, use the code
// default"; an empty string is a deliberate choice to hide the box.
model Settings {
  id                 String   @id @default(uuid(7)) @db.Uuid
  key                String   @unique @default("payment_config")
  bankNameId         String   @map("bank_name_id")
  bankAccountId      String   @map("bank_account_id")
  prefixMessage      String   @default("SAB") @map("prefix_message")
  storeTitle         String?  @map("store_title")
  checkoutNotice     String?  @map("checkout_notice")
  eventNotice        String?  @map("event_notice")
  paymentNotice      String?  @map("payment_notice")
  contactEmail       String?  @map("contact_email")
  contactFacebookUrl String?  @map("contact_facebook_url")
  googleClientId     String?  @map("google_client_id")
  updatedBy          String   @default("system") @map("updated_by")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

// The SMTP account for order mail: one row, kept out of `settings` on purpose so
// the admin data export, which lists its tables explicitly, can never carry the
// credential. pass_encrypted is an AES-256-GCM envelope (lib/secret-box.js).
model MailSettings {
  id                  String   @id @default(uuid(7)) @db.Uuid
  key                 String   @unique @default("smtp")
  enabled             Boolean  @default(false)
  host                String
  port                Int
  secure              Boolean  @default(false)
  username            String
  passEncrypted       String   @map("pass_encrypted")
  fromName            String   @map("from_name")
  fromAddress         String   @map("from_address")
  notifyOrderCreated  Boolean  @default(true) @map("notify_order_created")
  notifyStatusChanged Boolean  @default(true) @map("notify_status_changed")
  updatedBy           String   @default("system") @map("updated_by")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("mail_settings")
}

// better-auth 1.7.7 tables, hand-written from the shape measured for the app's
// plugins (username, admin, jwt); not generated. Once the Prisma adapter is wired,
// diff this file against `auth generate --adapter prisma` and reconcile. Column
// names stay camelCase because the adapter maps by field name. Deliberate deltas
// from the generator: unique username, unique (providerId, accountId) and
// timestamptz.
// Every id is a UUIDv7, like the store tables. better-auth would otherwise mint
// its own 32-character ids, so its config must set advanced.database.generateId
// to a UUIDv7 generator; the Prisma default only covers rows created through the
// client directly. Migrated rows carry their ObjectId mapped with objectIdToUuidV7.

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  email           String
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  username        String
  displayUsername String?
  role            String?   @default("user")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime? @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  expiresAt      DateTime @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  userId         String   @db.Uuid
  impersonatedBy String?  @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id @default(uuid(7)) @db.Uuid
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?

  @@map("jwks")
}

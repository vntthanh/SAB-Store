{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// Entry points that package.json scripts/main, the jest, vitest and vite plugins
	// already discover (backend start.js/server.js, frontend src/index.jsx, tests, setup files) are
	// deliberately not repeated here: knip reports redundant entries as hints.
	// `project` globs narrow analysis (no uploaded files, frontend src (js/jsx), scripts and css, shared .mjs and
	// tests); files outside them are not analysed and their imports do not count as usage.
	"ignoreBinaries": [
		// Husky hooks call `pnpm build` (a frontend script name) and `pnpm exec vitest`
		// (a frontend devDependency); knip reads them as root-level binaries.
		"build",
		"vitest"
	],
	"ignoreIssues": {
		// knip does not follow CommonJS consumers that reach an export through a
		// namespace or static member (`stockQueue.sweepOnce()`, `Settings.NOTICE_FIELDS`,
		// `jest.spyOn(minio, 'getFile')`, `ledger.CRITICAL_AFTER_ATTEMPTS`), so
		// these files report exports that are in fact used.
		"backend/queues/stock-queue.js": ["exports"],
		"backend/models/Settings.js": ["exports"],
		"backend/models/StockMovement.js": ["exports"],
		"backend/lib/minio.js": ["exports"],
		"backend/services/stock-ledger.js": ["exports"],
		"backend/utils/public-code.js": ["exports"]
	},
	"workspaces": {
		".": {},
		"backend": {
			// Operational scripts are run by hand (`node scripts/x.js`), never imported.
			"entry": ["scripts/*.js"],
			"project": ["**/*.js", "!uploads/**"]
		},
		"frontend": {
			"project": ["src/**/*.{js,jsx,css}", "scripts/**/*.mjs"]
		},
		"packages/shared": {
			"project": ["src/**/*.js", "tests/**/*.js", "*.mjs"]
		}
	}
}

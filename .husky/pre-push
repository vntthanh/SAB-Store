# Pre-push gate over every file in the pushed range: the full backend suite when
# backend/ changed, the frontend production bundle and unit tests when frontend/ changed, and all
# three plus the shared package tests when workspace plumbing (packages/*, root
# manifest, lockfile, workspace file) changed.
# knip (unused files, exports, dependencies) runs first, before any test or build.
# The contract suite on Postgres (`pnpm test:contract:postgres`) runs next, ahead
# of the full backend suite, when a pushed path is in touches_postgres_contract below.
# Anything else (Markdown, hooks, compose files) runs nothing. Work runs under
# the machine-wide heavy lock (lib/heavy-lock.sh).
. "$(dirname "$0")/lib/require-bash.sh"
# shellcheck source=lib/hook-env.sh
. "$(dirname "$0")/lib/hook-env.sh"
set -Eeuo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# postgres-contract-paths:begin
# Code the Postgres contract suite (backend/tests/contract on DATA_BACKEND=postgres)
# loads or is built from: the data layer and what it requires (services, lib, models,
# queues, constants, utils), the Prisma schema and migrations, the test harness and
# helpers, the backend manifest and vitest configs, and workspace plumbing (the shared
# package supplies id mapping and validation). Routes, middleware and scripts are not
# in its require closure, so they do not trigger it. The same list is in pre-commit and
# pre-push; backend/tests/architecture/hook-postgres-trigger.test.js keeps the two equal.
touches_postgres_contract() {
	case "$1" in
		*.md) return 1 ;;
		package.json | pnpm-lock.yaml | pnpm-workspace.yaml | .npmrc | packages/*) return 0 ;;
		backend/package.json | backend/vitest*.mjs | backend/prisma.config.cjs | backend/prisma/* | \
			backend/data/* | backend/lib/* | backend/models/* | backend/services/* | backend/queues/* | \
			backend/constants/* | backend/utils/* | \
			backend/tests/contract/* | backend/tests/helpers/* | \
			backend/tests/env.js | backend/tests/setup.js | backend/tests/global-setup.js) return 0 ;;
	esac
	return 1
}
# postgres-contract-paths:end

ZERO_SHA="0000000000000000000000000000000000000000"

# heavy_lock_hook re-runs this script under the lock, and the ref list arrives
# on stdin only once: keep it and hand it to the re-run.
REFS="${CC_SAB_PUSH_REFS-$(cat)}"

backend_changed=false
frontend_changed=false
shared_changed=false
postgres_contract=false
while read -r local_ref local_sha remote_ref remote_sha; do
	[[ -z "${local_ref:-}" || "$local_sha" == "$ZERO_SHA" ]] && continue
	if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
		# New remote branch: compare against the empty tree, i.e. treat every file as pushed.
		range="$(git hash-object -t tree /dev/null)..$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi
	# Fail closed: an unreadable range (e.g. the remote moved and was not fetched)
	# must run every gate, never skip them.
	if ! files="$(git diff --name-only "$range" --)"; then
		echo "pre-push: cannot diff $range, running every check" >&2
		backend_changed=true
		frontend_changed=true
		shared_changed=true
		postgres_contract=true
		continue
	fi
	while IFS= read -r f; do
		if touches_postgres_contract "$f"; then postgres_contract=true; fi
		case "$f" in
			*.md) ;;
			package.json | pnpm-lock.yaml | pnpm-workspace.yaml | .npmrc | packages/*)
				backend_changed=true; frontend_changed=true; shared_changed=true ;;
			backend/*) backend_changed=true ;;
			frontend/*) frontend_changed=true ;;
		esac
	done <<<"$files"
done <<<"$REFS"

if [[ "$backend_changed" == false && "$frontend_changed" == false && "$shared_changed" == false ]]; then
	echo "pre-push: no backend or frontend code pushed, nothing to run"
	exit 0
fi

# shellcheck source=lib/heavy-lock.sh
source "$ROOT/.husky/lib/heavy-lock.sh"
CC_SAB_PUSH_REFS="$REFS" heavy_lock_hook SAB-Store pre-push "$0" "$@"

# Before every test and build step: the cheapest whole-repo check goes first.
echo "pre-push: knip (unused files, exports, dependencies)"
(cd "$ROOT" && pnpm --silent knip)

if [[ "$postgres_contract" == true ]]; then
	echo "pre-push: data layer, schema or harness changed, running the contract suite on Postgres"
	(cd "$ROOT/backend" && pnpm --silent test:contract:postgres)
fi

if [[ "$backend_changed" == true ]]; then
	echo "pre-push: full backend suite"
	(cd "$ROOT/backend" && pnpm --silent test)
fi

if [[ "$frontend_changed" == true ]]; then
	echo "pre-push: frontend changed, building the production bundle"
	(cd "$ROOT/frontend" && pnpm --silent build >/dev/null)
	echo "pre-push: frontend unit tests"
	(cd "$ROOT/frontend" && pnpm --silent exec vitest run)
fi

# No-op until the package exists, so the hook keeps working on a tree without it.
if [[ "$shared_changed" == true && -f "$ROOT/packages/shared/package.json" ]]; then
	echo "pre-push: workspace or shared package changed, running the shared package tests"
	(cd "$ROOT" && pnpm --silent --filter @sab/shared test)
fi

# Pre-commit gate, scoped to what is staged:
# - more than MAX_STAGED files: refused, split the commit by module (keeps each
#   commit small enough for the multi-agent review before it);
# - knip (unused files, exports, dependencies) runs first, before any test or build,
#   whenever code or a manifest is staged: it is cheap and fails the commit early;
# - backend: Vitest on the staged test files, or the full suite when any backend
#   module, the test harness or the backend manifest changed. `vitest related` is not used
#   for source files: the backend loads its modules with native require(), which
#   Vitest's module graph cannot see, so it would find no tests and skip them silently;
# - Mongo contract suite (`pnpm test:contract:mongo`): runs after knip and
#   before the backend suite (which runs on Postgres) whenever a staged path is in
#   touches_mongo_contract below, so a change to the data layer cannot break the rollback
#   store unnoticed. It is a separate command, not
#   chained into `pnpm test`, because this hook appends staged test files to `pnpm test`
#   and they would reach only the last command of a chained script;
# - frontend: the production bundle must build and the frontend unit tests must pass;
# - workspace plumbing (packages/*, root manifest, lockfile, workspace file): every
#   consumer is affected, so the full backend suite, the frontend build and tests and the
#   shared package's own tests all run;
# - anything else (Markdown, hooks, compose files): nothing to run.
# Tests and the build run under the machine-wide heavy lock (lib/heavy-lock.sh),
# which is only taken when there is work to do.
. "$(dirname "$0")/lib/require-bash.sh"
# shellcheck source=lib/hook-env.sh
. "$(dirname "$0")/lib/hook-env.sh"
set -Eeuo pipefail

MAX_STAGED=29
ROOT="$(git rev-parse --show-toplevel)"

# mongo-contract-paths:begin
# Code the Mongo contract suite (backend/tests/contract on DATA_BACKEND=mongo, the
# rollback store) loads or is built from: the data layer and what it requires (services, lib, models,
# queues, constants, utils), the Prisma schema and migrations, the test harness and
# helpers, the backend manifest and vitest configs, and workspace plumbing (the shared
# package supplies id mapping and validation). Routes, middleware and scripts are not
# in its require closure, so they do not trigger it. The same list is in pre-commit and
# pre-push; backend/tests/architecture/hook-mongo-trigger.test.js keeps the two equal.
touches_mongo_contract() {
	case "$1" in
		*.md) return 1 ;;
		package.json | pnpm-lock.yaml | pnpm-workspace.yaml | .npmrc | packages/*) return 0 ;;
		backend/package.json | backend/vitest*.mjs | backend/prisma.config.cjs | backend/prisma/* | \
			backend/data/* | backend/lib/* | backend/models/* | backend/services/* | backend/queues/* | \
			backend/constants/* | backend/utils/* | \
			backend/tests/contract/* | backend/tests/helpers/* | \
			backend/tests/env.js | backend/tests/setup.js | backend/tests/global-setup.js) return 0 ;;
	esac
	return 1
}
# mongo-contract-paths:end

# --no-renames: a rename is listed as delete + add, so moving a shared file away
# still triggers the full suite through the deleted path.
mapfile -t STAGED < <(git diff --cached --name-status --no-renames)

# A merge commit cannot be split, so the size cap applies to ordinary commits only.
if ((${#STAGED[@]} > MAX_STAGED)) && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
	echo "pre-commit: ${#STAGED[@]} files staged, the limit is $MAX_STAGED. Split the commit by module." >&2
	exit 1
fi

backend_full=false
backend_files=()
frontend_changed=false
shared_changed=false
knip_needed=false
mongo_contract=false
for entry in "${STAGED[@]}"; do
	status="${entry%%$'\t'*}"
	f="${entry#*$'\t'}"
	# A deleted or moved file counts too: removing a helper breaks the suite as well.
	if touches_mongo_contract "$f"; then mongo_contract=true; fi
	# An import added or removed, or a manifest edit, can leave a file, an export
	# or a dependency unused (or used but undeclared) anywhere in the workspace.
	case "$f" in
		*.md) ;;
		package.json | */package.json | pnpm-lock.yaml | pnpm-workspace.yaml | knip.jsonc | \
			backend/* | frontend/* | packages/*)
			knip_needed=true ;;
	esac
	case "$f" in
		*.md) ;;
		package.json | pnpm-lock.yaml | pnpm-workspace.yaml | .npmrc | packages/*)
			backend_full=true; frontend_changed=true; shared_changed=true ;;
		backend/package.json | backend/vitest.config.mjs | \
			backend/tests/helpers/* | backend/tests/global-setup.js | \
			backend/tests/setup.js | backend/tests/env.js)
			backend_full=true ;;
		backend/tests/*)
			if [[ "$status" != D ]]; then backend_files+=("${f#backend/}"); fi ;;
		backend/*.js)
			# Vitest cannot map a module to the tests that require() it: run everything.
			backend_full=true ;;
		frontend/*)
			frontend_changed=true ;;
	esac
done

if [[ "$backend_full" == false && ${#backend_files[@]} -eq 0 && "$frontend_changed" == false && "$shared_changed" == false && "$knip_needed" == false && "$mongo_contract" == false ]]; then
	echo "pre-commit: no backend or frontend code staged, nothing to run"
	exit 0
fi

# shellcheck source=lib/heavy-lock.sh
source "$ROOT/.husky/lib/heavy-lock.sh"
heavy_lock_hook SAB-Store pre-commit "$0" "$@"

# Before every test and build step: knip is the cheapest whole-repo check, so an
# unused file, export or dependency must fail here, not after a full suite.
if [[ "$knip_needed" == true ]]; then
	echo "pre-commit: knip (unused files, exports, dependencies)"
	(cd "$ROOT" && pnpm --silent knip)
fi

if [[ "$mongo_contract" == true ]]; then
	echo "pre-commit: data layer, schema or harness changed, running the contract suite on Mongo (rollback store)"
	(cd "$ROOT/backend" && pnpm --silent test:contract:mongo)
fi

if [[ "$backend_full" == true ]]; then
	echo "pre-commit: backend module or test harness changed, running the full backend suite"
	(cd "$ROOT/backend" && pnpm --silent test)
elif ((${#backend_files[@]} > 0)); then
	echo "pre-commit: ${#backend_files[@]} staged backend test file(s)"
	(cd "$ROOT/backend" && pnpm --silent test --passWithNoTests "${backend_files[@]}")
fi

if [[ "$frontend_changed" == true ]]; then
	echo "pre-commit: frontend changed, building the production bundle"
	(cd "$ROOT/frontend" && pnpm --silent build >/dev/null)
	echo "pre-commit: frontend unit tests"
	(cd "$ROOT/frontend" && pnpm --silent exec vitest run)
fi

# No-op until the package exists, so the hook keeps working on a tree without it.
if [[ "$shared_changed" == true && -f "$ROOT/packages/shared/package.json" ]]; then
	echo "pre-commit: workspace or shared package changed, running the shared package tests"
	(cd "$ROOT" && pnpm --silent --filter @sab/shared test)
fi
